# Configuración para alojamiento Apache (cPanel de Namecheap).
#
# El sitio es un export estático de Next.js: HTML ya generado, sin servidor.
# Apache solo tiene que servir archivos, pero necesita tres ajustes.

# 1. Página de error propia en vez de la de Apache.
ErrorDocument 404 /404.html

# 2. Todo por HTTPS. El certificado lo emite AutoSSL de cPanel.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Excepcion: /.well-known/ se sirve por HTTP sin redirigir.
  #
  # Es la carpeta que usan las autoridades de certificacion para comprobar
  # que el dominio es tuyo. Piden el archivo por HTTP, y si se les redirige a
  # HTTPS antes de que exista el certificado, la validacion falla: no pueden
  # completar el TLS. Sin esta excepcion, emitir o renovar el certificado se
  # vuelve imposible.
  RewriteRule ^\.well-known/ - [L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Idioma en la raíz. El dominio pelado no es una página: lleva a /es/, /en/
  # o /pt/ según el primer idioma que pida el navegador.
  #
  # Se hace aquí, en el servidor, y no solo con el index.html que redirige con
  # JavaScript: Google no ejecuta esa redirección ni manda idioma, y veía una
  # página vacía con «noindex» como portada del dominio. Sin cabecera de
  # idioma —Googlebot— va al español, que es el idioma por defecto.
  #
  # Es 302 y no 301 porque el destino depende de quién pregunta. Los idiomas
  # que la web no tiene (francés, alemán…) NO entran en ninguna regla y caen
  # al index.html de siempre, que sí recorre la lista de preferencias.
  RewriteCond %{HTTP:Accept-Language} ^\s*pt [NC]
  RewriteRule ^$ /pt/ [R=302,L]
  RewriteCond %{HTTP:Accept-Language} ^\s*en [NC]
  RewriteRule ^$ /en/ [R=302,L]
  RewriteCond %{HTTP:Accept-Language} ^\s*(es|$) [NC]
  RewriteRule ^$ /es/ [R=302,L]
</IfModule>

# El manifiesto de la web (instalar en el móvil). Sin este tipo, algunos
# Apache lo sirven como texto plano y Chrome lo ignora.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# 3. Caché.
<IfModule mod_expires.c>
  ExpiresActive On

  # Los archivos de /_next/static/ llevan un hash en el nombre: si cambia el
  # contenido, cambia el nombre. Se pueden cachear para siempre sin riesgo.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>

  # El HTML NO se cachea de forma agresiva: si no, al publicar una versión
  # nueva el visitante seguiría viendo la vieja durante días.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>

  # El favicon se pide siempre como «/favicon.ico», sin versión en la
  # dirección, así que con seis meses de caché un cambio de icono tardaría
  # medio año en llegar a quien ya visitó la web. Un día basta.
  <FilesMatch "^(favicon\.ico|manifest\.webmanifest)$">
    ExpiresDefault "access plus 1 day"
  </FilesMatch>
</IfModule>

# 4. Compresión, si el servidor la tiene disponible.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
